# ==============================================================================
# NexusBlog Full-Stack Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Vite / Client)
# ------------------------------------------------------------------------------
# URL to your Payload CMS REST API (e.g. local CMS port or production backend)
VITE_PAYLOAD_API_URL="http://localhost:3001/api"

# Public site address (used for SEO canonical URLs, OG tags, sitemap)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PAYLOAD CMS & POSTGRESQL (Backend)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URI (compatible with local Postgres, Supabase, Neon, AWS RDS)
DATABASE_URI="postgresql://postgres:password@localhost:5432/nexusblog"

# Secure random secret key for Payload CMS sessions (min 32 chars: openssl rand -base64 32)
PAYLOAD_SECRET="your_32_character_random_payload_secret_key_here"

# Allowed CORS origins for Payload CMS API (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-domain.vercel.app"

# Server Port for Payload CMS
PORT=3001

# ------------------------------------------------------------------------------
# OPTIONAL / EXTERNAL SERVICES
# ------------------------------------------------------------------------------
# Optional Gemini AI API key (if server-side text/image AI analysis is enabled)
GEMINI_API_KEY=""

# Optional SMTP Email for editorial notifications
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD=""
FROM_EMAIL="editorial@nexusblog.dev"
