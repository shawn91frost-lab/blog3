# ==============================================================================
# Payload CMS Environment Configuration
# ==============================================================================

# Server Port (CMS API runs on 3001 to avoid colliding with frontend on 3000)
PORT=3001

# PostgreSQL Database Connection URI (Supports Supabase, Neon, Cloud SQL, Local)
# Example: postgresql://postgres:password@localhost:5432/nexusblog
DATABASE_URI=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Payload Secret Key (Generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your_32_character_random_payload_secret_key_here

# Frontend Application Origin (CORS & CSRF protection)
CORS_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# Public Server URL
SERVER_URL=http://localhost:3001
